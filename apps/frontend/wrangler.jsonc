{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inversiones-willians-marte-web-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "INTERNAL_API_URL": "https://api-staging.example.com/api/v1",
    "MOBILE_BASE_URL": "https://staging.example.com"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
