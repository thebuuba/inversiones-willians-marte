{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inversiones-willians-marte-web-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "INTERNAL_API_URL": "https://inversiones-willians-marte-api-staging.natanaelpena1202.workers.dev/api/v1",
    "MOBILE_BASE_URL": "https://inversiones-willians-marte-web-staging.natanaelpena1202.workers.dev",
  },
  "services": [
    {
      "binding": "BACKEND_API",
      "service": "inversiones-willians-marte-api-staging",
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
}
