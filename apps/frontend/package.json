{
  "name": "@inversiones/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test $(find src -name '*.test.ts' -type f)",
    "worker:build": "pnpm --filter @inversiones/shared build && NEXT_PUBLIC_API_URL=https://inversiones-willians-marte-api-staging.natanaelpena1202.workers.dev/api/v1 opennextjs-cloudflare build",
    "worker:preview": "pnpm worker:build && opennextjs-cloudflare preview",
    "worker:deploy:staging": "pnpm worker:build && opennextjs-cloudflare deploy",
    "worker:upload:staging": "pnpm worker:build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@inversiones/shared": "workspace:*",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@opennextjs/cloudflare": "^1.20.1",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.400.0",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "wrangler": "^4.110.0"
  }
}
