PORT=3000
DATABASE_URL=postgresql://inversiones:CHANGE_ME@localhost:5432/inversiones
JWT_SECRET=change-me-to-a-random-secret
FRONTEND_URL=http://localhost:3001
NODE_ENV=development
ADMIN_EMAIL=admin@inversiones.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Cloudflare Workers local development only. In staging/production use secrets
# and prefer the HYPERDRIVE binding over a direct DATABASE_URL connection.
CLOUDFLARE_WORKER=false
