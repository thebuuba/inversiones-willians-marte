generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COLLECTOR
}

enum LoanStatus {
  ACTIVE
  PAID
  OVERDUE
  RESTRUCTURED
  WRITTEN_OFF
}

enum InterestType {
  FLAT
  REDUCING
  COMPOUND
  FIXED
  INDEFINITE
}

enum PaymentFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

enum ScheduleStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

enum AllocationType {
  PRINCIPAL
  INTEREST
  PENALTY
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum InvestorInvestmentStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum InvestorInvestmentMovementType {
  CAPITAL_ADDITION
}

// ─── Users ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  username     String?  @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(COLLECTOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdClients    Client[]      @relation("ClientCreatedBy")
  createdLoans      Loan[]        @relation("LoanCreatedBy")
  receivedPayments  Payment[]     @relation("PaymentReceivedBy")
  auditLogs         AuditLog[]
  loanRequests      LoanRequest[]
  investors              Investor[]
  investorInvestments    InvestorInvestment[] @relation("InvestorInvestmentCreatedBy")
  investorInvestmentMovements InvestorInvestmentMovement[] @relation("InvestorInvestmentMovementCreatedBy")
  investorPayments       InvestorPayment[] @relation("InvestorPaymentReceivedBy")
  uploadedDocuments      Document[]
  documentCaptureSessions DocumentCaptureSession[]
  tasks                  Task[]
  portfolios             Portfolio[]

  @@index([role, active])
  @@map("users")
}

// ─── Clients ────────────────────────────────────────────────────────────────

model Client {
  id             Int       @id @default(autoincrement())
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  phone          String?
  altPhone       String?   @map("alt_phone")
  email          String?
  identification String?   @map("identification")
  address        String?
  birthDate      DateTime? @map("birth_date")
  gender         String?
  maritalStatus  String?   @map("marital_status")
  nationality    String?
  dependents     Int?
  photo          String?
  notes          String?
  createdById    String    @map("created_by")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  createdBy    User          @relation("ClientCreatedBy", fields: [createdById], references: [id])
  loans        Loan[]
  payments     Payment[]
  loanRequests LoanRequest[]
  documents    Document[]
  auditLogs    AuditLog[]
  documentCaptureSessions DocumentCaptureSession[]

  @@index([active, createdAt])
  @@map("clients")
}

// ─── Loan Requests (Solicitudes) ───────────────────────────────────────────

model LoanRequest {
  id             String        @id @default(uuid())
  code           String        @unique
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  identification String?
  phone          String?
  amount         Decimal
  description    String?
  reference      String?
  status         RequestStatus @default(PENDING)
  createdById    String        @map("created_by")
  clientId       Int?          @map("client_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  createdBy User    @relation(fields: [createdById], references: [id])
  client    Client? @relation(fields: [clientId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("loan_requests")
}

// ─── Loan Products (templates) ──────────────────────────────────────────────

model LoanProduct {
  id                String            @id @default(uuid())
  name              String
  interestType      InterestType      @map("interest_type")
  interestRate      Decimal           @map("interest_rate")
  interestFrequency PaymentFrequency? @map("interest_frequency")
  paymentFrequency  PaymentFrequency  @map("payment_frequency")
  maxAmount         Decimal?          @map("max_amount")
  minAmount         Decimal?          @map("min_amount")
  maxTerm           Int?              @map("max_term")
  latePenaltyType   String?           @map("late_penalty_type")
  latePenaltyValue  Decimal?          @map("late_penalty_value")
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  loans Loan[]

  @@index([active, name])
  @@map("loan_products")
}

// ─── Loans ──────────────────────────────────────────────────────────────────

model Loan {
  id           String           @id @default(uuid())
  loanNumber   Int              @unique @default(autoincrement()) @map("loan_number")
  clientId     Int              @map("client_id")
  productId    String           @map("product_id")
  principal    Decimal
  interestRate Decimal          @map("interest_rate")
  interestType InterestType     @map("interest_type")
  totalAmount  Decimal          @map("total_amount")
  paymentFreq  PaymentFrequency @map("payment_frequency")
  term         Int
  startDate    DateTime         @map("start_date")
  endDate      DateTime?        @map("end_date")
  status       LoanStatus       @default(ACTIVE)
  balance      Decimal
  notes        String?
  createdById  String           @map("created_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  client      Client            @relation(fields: [clientId], references: [id])
  product     LoanProduct       @relation(fields: [productId], references: [id])
  createdBy   User              @relation("LoanCreatedBy", fields: [createdById], references: [id])
  portfolioId String?           @map("portfolio_id")
  schedule    PaymentSchedule[]
  payments    Payment[]
  lateFees    LateFee[]
  portfolio   Portfolio?        @relation(fields: [portfolioId], references: [id])

  @@index([clientId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([portfolioId, createdAt])
  @@index([startDate])
  @@index([status, endDate])
  @@map("loans")
}

// ─── Payment Schedule ──────────────────────────────────────────────────────

model PaymentSchedule {
  id            String         @id @default(uuid())
  loanId        String         @map("loan_id")
  dueDate       DateTime       @map("due_date")
  amount        Decimal
  principalPart Decimal        @map("principal_part")
  interestPart  Decimal        @map("interest_part")
  balanceAfter  Decimal        @map("balance_after")
  status        ScheduleStatus @default(PENDING)
  paidDate      DateTime?      @map("paid_date")
  paidAmount    Decimal?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  loan          Loan                @relation(fields: [loanId], references: [id])
  lateFees      LateFee[]
  paymentAllocs PaymentAllocation[]

  @@index([loanId, dueDate])
  @@index([dueDate, status])
  @@index([status, loanId])
  @@map("payment_schedule")
}

// ─── Payments ───────────────────────────────────────────────────────────────

model Payment {
  id            String   @id @default(uuid())
  loanId        String   @map("loan_id")
  clientId      Int      @map("client_id")
  amount        Decimal
  paymentDate   DateTime @map("payment_date")
  paymentMethod String?  @map("payment_method")
  reference     String?
  receivedById  String   @map("received_by")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  loan        Loan                @relation(fields: [loanId], references: [id])
  client      Client              @relation(fields: [clientId], references: [id])
  receivedBy  User                @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  allocations PaymentAllocation[]

  @@index([loanId, paymentDate])
  @@index([clientId])
  @@index([receivedById])
  @@index([paymentDate])
  @@map("payments")
}

// ─── Payment Allocations ────────────────────────────────────────────────────

model PaymentAllocation {
  id         String         @id @default(uuid())
  paymentId  String         @map("payment_id")
  scheduleId String         @map("schedule_id")
  amount     Decimal
  type       AllocationType

  payment  Payment         @relation(fields: [paymentId], references: [id])
  schedule PaymentSchedule @relation(fields: [scheduleId], references: [id])

  @@index([paymentId])
  @@index([scheduleId])
  @@map("payment_allocations")
}

// ─── Late Fees ──────────────────────────────────────────────────────────────

model LateFee {
  id             String   @id @default(uuid())
  loanId         String   @map("loan_id")
  scheduleId     String   @map("schedule_id")
  amount         Decimal
  calculatedDate DateTime @map("calculated_date")
  paid           Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  loan     Loan            @relation(fields: [loanId], references: [id])
  schedule PaymentSchedule @relation(fields: [scheduleId], references: [id])

  @@index([loanId])
  @@index([scheduleId])
  @@map("late_fees")
}

// ─── Investors ──────────────────────────────────────────────────────────────

enum InvestorStatus {
  ACTIVE
  PAUSED
  WITHDRAWN
}

model Investor {
  id             String         @id @default(uuid())
  code           String         @unique
  name           String
  email          String?
  phone          String?
  phone2         String?        @map("phone_2")
  cedula         String?
  birthDate      DateTime?      @map("birth_date")
  nationality    String?
  type           String         @default("individual")
  photo          String?
  capital        Decimal        @default(0)
  monthlyPayment Decimal        @default(0) @map("monthly_payment")
  rate           Decimal        @default(0)
  startDate      DateTime?      @map("start_date")
  term           String?
  bank           String?
  status         InvestorStatus @default(ACTIVE)
  notes          String?
  createdById    String         @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  createdBy User       @relation(fields: [createdById], references: [id])
  documents Document[]
  investments InvestorInvestment[]
  payments  InvestorPayment[]

  @@index([createdAt])
  @@map("investors")
}

model InvestorInvestment {
  id             String                   @id @default(uuid())
  investorId     String                   @map("investor_id")
  code           String                   @unique
  capital        Decimal                  @default(0)
  monthlyPayment Decimal                  @default(0) @map("monthly_payment")
  rate           Decimal                  @default(0)
  startDate      DateTime?                @map("start_date")
  term           String?
  status         InvestorInvestmentStatus @default(ACTIVE)
  notes          String?
  createdById    String                   @map("created_by")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  investor  Investor @relation(fields: [investorId], references: [id])
  createdBy User     @relation("InvestorInvestmentCreatedBy", fields: [createdById], references: [id])
  payments  InvestorPayment[]
  movements InvestorInvestmentMovement[]

  @@index([investorId])
  @@index([createdAt])
  @@map("investor_investments")
}

model InvestorInvestmentMovement {
  id           String                         @id @default(uuid())
  investmentId String                         @map("investment_id")
  type         InvestorInvestmentMovementType
  amount       Decimal
  movementDate DateTime                       @map("movement_date")
  notes        String?
  createdById  String                         @map("created_by")
  createdAt    DateTime                       @default(now()) @map("created_at")

  investment InvestorInvestment @relation(fields: [investmentId], references: [id])
  createdBy  User               @relation("InvestorInvestmentMovementCreatedBy", fields: [createdById], references: [id])

  @@index([investmentId, movementDate(sort: Desc)])
  @@map("investor_investment_movements")
}

// ─── Investor Payments ─────────────────────────────────────────────────────

model InvestorPayment {
  id            String   @id @default(uuid())
  receiptNumber Int      @map("receipt_number")
  investorId    String   @map("investor_id")
  investmentId  String?  @map("investment_id")
  amount        Decimal
  periodMonth   Int      @map("period_month")
  periodYear    Int      @map("period_year")
  paymentDate   DateTime @map("payment_date")
  paymentMethod String?  @map("payment_method")
  reference     String?
  notes         String?
  receivedById  String   @map("received_by")
  createdAt     DateTime @default(now()) @map("created_at")

  investor   Investor @relation(fields: [investorId], references: [id])
  investment InvestorInvestment? @relation(fields: [investmentId], references: [id])
  receivedBy User     @relation("InvestorPaymentReceivedBy", fields: [receivedById], references: [id])

  @@unique([investmentId, periodMonth, periodYear])
  @@index([receiptNumber])
  @@index([investorId, periodYear(sort: Desc), periodMonth(sort: Desc)])
  @@index([investmentId, periodYear(sort: Desc), periodMonth(sort: Desc)])
  @@index([paymentDate])
  @@map("investor_payments")
}

// ─── Documents ──────────────────────────────────────────────────────────────

model Document {
  id           String   @id @default(uuid())
  clientId     Int?     @map("client_id")
  investorId   String?  @map("investor_id")
  loanId       String?  @map("loan_id")
  name         String
  category     String   @default("general")
  fileUrl      String?  @map("file_url")
  fileSize     Int?     @map("file_size")
  mimeType     String?  @map("mime_type")
  originalFileUrl     String? @map("original_file_url")
  processedFileUrl    String? @map("processed_file_url")
  documentType        String  @default("otro") @map("document_type")
  detectionConfidence Int     @default(0) @map("detection_confidence")
  processingStatus    String  @default("not_applicable") @map("processing_status")
  processingNotes     String? @map("processing_notes")
  notes        String?
  uploadedById String   @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  uploadedBy User      @relation(fields: [uploadedById], references: [id])
  client     Client?   @relation(fields: [clientId], references: [id])
  investor   Investor? @relation(fields: [investorId], references: [id])

  @@index([clientId, createdAt])
  @@index([investorId, createdAt])
  @@index([documentType])
  @@index([processingStatus])
  @@map("documents")
}

model DocumentCaptureSession {
  id          String    @id @default(uuid())
  token       String    @unique
  clientId    Int       @map("client_id")
  createdById String    @map("created_by")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  closedAt    DateTime? @map("closed_at")
  uploadCount Int       @default(0) @map("upload_count")
  maxUploads  Int       @default(5) @map("max_uploads")
  createdAt   DateTime  @default(now()) @map("created_at")

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([clientId, createdAt])
  @@index([token, expiresAt])
  @@map("document_capture_sessions")
}

// ─── Tasks / Agenda ─────────────────────────────────────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?    @map("due_date")
  time        String?
  priority    TaskPriority @default(MEDIUM)
  category    String       @default("oficina")
  status      TaskStatus   @default(PENDING)
  createdById String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([status(sort: Asc), priority(sort: Desc), dueDate(sort: Asc), createdAt(sort: Desc)])
  @@map("tasks")
}

// ─── Portfolios (Carteras) ──────────────────────────────────────────────────

model Portfolio {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#5FA37D")
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User   @relation(fields: [createdById], references: [id])
  loans     Loan[]

  @@index([createdAt])
  @@map("portfolios")
}

// ─── Audit Log ──────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at")
  clientId   Int?     @map("client_id")

  user   User    @relation(fields: [userId], references: [id])
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
