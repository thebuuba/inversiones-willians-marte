generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COLLECTOR
}

enum LoanStatus {
  ACTIVE
  PAID
  OVERDUE
  RESTRUCTURED
  WRITTEN_OFF
}

enum LoanOperationType {
  NORMAL
  REENGAGEMENT
  REFINANCE
}

enum InterestType {
  FLAT
  REDUCING
  COMPOUND
  FIXED
  INDEFINITE
}

enum PaymentFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
}

enum ScheduleStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
}

enum AllocationType {
  PRINCIPAL
  INTEREST
  PENALTY
}

enum CollectionChannel {
  CALL
  WHATSAPP
  VISIT
  SMS
  EMAIL
  OTHER
}

enum CollectionResult {
  CONTACTED
  NO_ANSWER
  WRONG_NUMBER
  PAYMENT_PROMISE
  EXTENSION_REQUEST
  DISPUTE
  REFUSED
  OTHER
}

enum PaymentPromiseStatus {
  PENDING
  PARTIAL
  FULFILLED
  BROKEN
  CANCELLED
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum InvestorInvestmentStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum InvestorInvestmentMovementType {
  CAPITAL_ADDITION
}

enum CashMovementType {
  IN
  OUT
}

// ─── Users ──────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  username     String?  @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(COLLECTOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  createdClients              Client[]                     @relation("ClientCreatedBy")
  createdLoans                Loan[]                       @relation("LoanCreatedBy")
  receivedPayments            Payment[]                    @relation("PaymentReceivedBy")
  auditLogs                   AuditLog[]
  loanRequests                LoanRequest[]
  investors                   Investor[]
  investorInvestments         InvestorInvestment[]         @relation("InvestorInvestmentCreatedBy")
  investorInvestmentMovements InvestorInvestmentMovement[] @relation("InvestorInvestmentMovementCreatedBy")
  investorPayments            InvestorPayment[]            @relation("InvestorPaymentReceivedBy")
  uploadedDocuments           Document[]
  documentCaptureSessions     DocumentCaptureSession[]
  clientPhotoCaptureSessions  ClientPhotoCaptureSession[]
  tasks                       Task[]                       @relation("TaskCreatedBy")
  assignedTasks               Task[]                       @relation("TaskAssignee")
  notificationReads           NotificationRead[]
  portfolios                  Portfolio[]
  loanCapitalMovements        LoanCapitalMovement[]
  generatedLoanReceipts       LoanReceipt[]                @relation("LoanReceiptGeneratedBy")
  collectionInteractions      CollectionInteraction[]      @relation("CollectionInteractionCreatedBy")
  paymentPromises             PaymentPromise[]             @relation("PaymentPromiseCreatedBy")
  cashMovements               CashMovement[]
  authSessions                AuthSession[]

  @@index([role, active])
  @@map("users")
}

model AuthSession {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  familyId   String    @map("family_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// ─── Manual cash movements ────────────────────────────────────────────────

model CashMovement {
  id             String           @id @default(uuid())
  type           CashMovementType
  person         String
  amount         Decimal
  movementDate   DateTime         @map("movement_date")
  category       String
  paymentMethod  String?          @map("payment_method")
  description    String?
  affectsBalance Boolean          @default(true) @map("affects_balance")
  createdById    String           @map("created_by")
  createdAt      DateTime         @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@index([movementDate(sort: Desc)])
  @@index([type, movementDate(sort: Desc)])
  @@map("cash_movements")
}

// ─── Clients ────────────────────────────────────────────────────────────────

model Client {
  id             Int       @id @default(autoincrement())
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  phone          String?
  altPhone       String?   @map("alt_phone")
  email          String?
  identification String?   @map("identification")
  address        String?
  birthDate      DateTime? @map("birth_date")
  gender         String?
  maritalStatus  String?   @map("marital_status")
  nationality    String?
  dependents     Int?
  photo          String?
  notes          String?
  createdById    String    @map("created_by")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  createdBy               User                        @relation("ClientCreatedBy", fields: [createdById], references: [id])
  loans                   Loan[]
  payments                Payment[]
  loanRequests            LoanRequest[]
  documents               Document[]
  auditLogs               AuditLog[]
  documentCaptureSessions DocumentCaptureSession[]
  photoCaptureSessions    ClientPhotoCaptureSession[]
  collectionInteractions  CollectionInteraction[]
  paymentPromises         PaymentPromise[]
  tasks                   Task[]

  @@index([active, createdAt])
  @@map("clients")
}

// ─── Loan Requests (Solicitudes) ───────────────────────────────────────────

model LoanRequest {
  id             String        @id @default(uuid())
  code           String        @unique
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  identification String?
  phone          String?
  amount         Decimal
  description    String?
  reference      String?
  status         RequestStatus @default(PENDING)
  createdById    String        @map("created_by")
  clientId       Int?          @map("client_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  createdBy User    @relation(fields: [createdById], references: [id])
  client    Client? @relation(fields: [clientId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("loan_requests")
}

// ─── Loan Products (templates) ──────────────────────────────────────────────

model LoanProduct {
  id                String            @id @default(uuid())
  name              String
  interestType      InterestType      @map("interest_type")
  interestRate      Decimal           @map("interest_rate")
  interestFrequency PaymentFrequency? @map("interest_frequency")
  paymentFrequency  PaymentFrequency  @map("payment_frequency")
  maxAmount         Decimal?          @map("max_amount")
  minAmount         Decimal?          @map("min_amount")
  maxTerm           Int?              @map("max_term")
  latePenaltyType   String?           @map("late_penalty_type")
  latePenaltyValue  Decimal?          @map("late_penalty_value")
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  loans Loan[]

  @@index([active, name])
  @@map("loan_products")
}

// ─── Loans ──────────────────────────────────────────────────────────────────

model Loan {
  id                 String            @id @default(uuid())
  loanNumber         Int               @unique @default(autoincrement()) @map("loan_number")
  clientId           Int               @map("client_id")
  productId          String            @map("product_id")
  principal          Decimal
  interestRate       Decimal           @map("interest_rate")
  interestType       InterestType      @map("interest_type")
  totalAmount        Decimal           @map("total_amount")
  paymentFreq        PaymentFrequency  @map("payment_frequency")
  term               Int
  startDate          DateTime          @map("start_date")
  endDate            DateTime?         @map("end_date")
  status             LoanStatus        @default(ACTIVE)
  balance            Decimal
  notes              String?
  createdById        String            @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  operationType      LoanOperationType @default(NORMAL) @map("operation_type")
  disbursedAmount    Decimal?          @map("disbursed_amount")
  lateFeeEnabled     Boolean           @default(false) @map("late_fee_enabled")
  lateFeeMode        String            @default("PER_INSTALLMENT") @map("late_fee_mode")
  lateFeeCalculation String            @default("PERCENTAGE") @map("late_fee_calculation")
  lateFeeValue       Decimal           @default(5) @map("late_fee_value")
  lateFeeGraceDays   Int               @default(5) @map("late_fee_grace_days")

  client                 Client                  @relation(fields: [clientId], references: [id])
  product                LoanProduct             @relation(fields: [productId], references: [id])
  createdBy              User                    @relation("LoanCreatedBy", fields: [createdById], references: [id])
  portfolioId            String?                 @map("portfolio_id")
  schedule               PaymentSchedule[]
  payments               Payment[]
  lateFees               LateFee[]
  capitalMovements       LoanCapitalMovement[]
  collectionInteractions CollectionInteraction[]
  paymentPromises        PaymentPromise[]
  tasks                  Task[]
  portfolio              Portfolio?              @relation(fields: [portfolioId], references: [id])
  replacementSources     LoanReplacement[]       @relation("ReplacementLoan")
  replacementTargets     LoanReplacement[]       @relation("SourceLoan")
  receipt                LoanReceipt?

  @@index([clientId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([portfolioId, createdAt])
  @@index([startDate])
  @@index([status, endDate])
  @@map("loans")
}

model LoanReplacement {
  newLoanId        String  @map("new_loan_id")
  sourceLoanId     String  @map("source_loan_id")
  settlementAmount Decimal @map("settlement_amount")

  newLoan    Loan @relation("ReplacementLoan", fields: [newLoanId], references: [id], onDelete: Cascade)
  sourceLoan Loan @relation("SourceLoan", fields: [sourceLoanId], references: [id])

  @@id([newLoanId, sourceLoanId])
  @@index([sourceLoanId])
  @@map("loan_replacements")
}

model LoanReceipt {
  id            String   @id @default(uuid())
  loanId        String   @unique @map("loan_id")
  receiptNumber Int      @unique @map("receipt_number")
  snapshot      Json
  generatedById String   @map("generated_by")
  createdAt     DateTime @default(now()) @map("created_at")

  loan        Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  generatedBy User @relation("LoanReceiptGeneratedBy", fields: [generatedById], references: [id])

  @@index([createdAt])
  @@map("loan_receipts")
}

// ─── Payment Schedule ──────────────────────────────────────────────────────

model PaymentSchedule {
  id            String         @id @default(uuid())
  loanId        String         @map("loan_id")
  dueDate       DateTime       @map("due_date")
  amount        Decimal
  principalPart Decimal        @map("principal_part")
  interestPart  Decimal        @map("interest_part")
  balanceAfter  Decimal        @map("balance_after")
  status        ScheduleStatus @default(PENDING)
  paidDate      DateTime?      @map("paid_date")
  paidAmount    Decimal?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  loan          Loan                @relation(fields: [loanId], references: [id])
  lateFees      LateFee[]
  paymentAllocs PaymentAllocation[]

  @@unique([loanId, dueDate])
  @@index([dueDate, status])
  @@index([status, loanId])
  @@map("payment_schedule")
}

// ─── Payments ───────────────────────────────────────────────────────────────

model Payment {
  id            String   @id @default(uuid())
  loanId        String   @map("loan_id")
  clientId      Int      @map("client_id")
  amount        Decimal
  paymentDate   DateTime @map("payment_date")
  paymentMethod String?  @map("payment_method")
  reference     String?
  receivedById  String   @map("received_by")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  loan        Loan                @relation(fields: [loanId], references: [id])
  client      Client              @relation(fields: [clientId], references: [id])
  receivedBy  User                @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  allocations PaymentAllocation[]

  @@index([loanId, paymentDate])
  @@index([clientId])
  @@index([receivedById])
  @@index([paymentDate])
  @@map("payments")
}

// ─── Collection management ─────────────────────────────────────────────────

model CollectionInteraction {
  id               String            @id @default(uuid())
  loanId           String            @map("loan_id")
  clientId         Int               @map("client_id")
  channel          CollectionChannel
  result           CollectionResult
  notes            String
  nextFollowUpDate DateTime?         @map("next_follow_up_date") @db.Date
  nextFollowUpTime String?           @map("next_follow_up_time")
  createdById      String            @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")

  loan         Loan            @relation(fields: [loanId], references: [id])
  client       Client          @relation(fields: [clientId], references: [id])
  createdBy    User            @relation("CollectionInteractionCreatedBy", fields: [createdById], references: [id])
  promise      PaymentPromise?
  followUpTask Task?

  @@index([loanId, createdAt(sort: Desc)])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([nextFollowUpDate])
  @@map("collection_interactions")
}

model PaymentPromise {
  id              String               @id @default(uuid())
  interactionId   String               @unique @map("interaction_id")
  loanId          String               @map("loan_id")
  clientId        Int                  @map("client_id")
  amount          Decimal
  fulfilledAmount Decimal              @default(0) @map("fulfilled_amount")
  dueDate         DateTime             @map("due_date") @db.Date
  status          PaymentPromiseStatus @default(PENDING)
  createdById     String               @map("created_by")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  interaction CollectionInteraction @relation(fields: [interactionId], references: [id])
  loan        Loan                  @relation(fields: [loanId], references: [id])
  client      Client                @relation(fields: [clientId], references: [id])
  createdBy   User                  @relation("PaymentPromiseCreatedBy", fields: [createdById], references: [id])

  @@index([loanId, status, dueDate])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([status, dueDate])
  @@map("payment_promises")
}

// ─── Payment Allocations ────────────────────────────────────────────────────

model PaymentAllocation {
  id         String         @id @default(uuid())
  paymentId  String         @map("payment_id")
  scheduleId String         @map("schedule_id")
  amount     Decimal
  type       AllocationType

  payment  Payment         @relation(fields: [paymentId], references: [id])
  schedule PaymentSchedule @relation(fields: [scheduleId], references: [id])

  @@index([paymentId])
  @@index([scheduleId])
  @@map("payment_allocations")
}

// ─── Late Fees ──────────────────────────────────────────────────────────────

model LateFee {
  id             String   @id @default(uuid())
  loanId         String   @map("loan_id")
  scheduleId     String   @map("schedule_id")
  amount         Decimal
  calculatedDate DateTime @map("calculated_date")
  paid           Boolean  @default(false)
  paidAmount     Decimal  @default(0) @map("paid_amount")
  createdAt      DateTime @default(now()) @map("created_at")

  loan     Loan            @relation(fields: [loanId], references: [id])
  schedule PaymentSchedule @relation(fields: [scheduleId], references: [id])

  @@unique([scheduleId])
  @@index([loanId])
  @@index([scheduleId])
  @@map("late_fees")
}

model LoanCapitalMovement {
  id            String   @id @default(uuid())
  loanId        String   @map("loan_id")
  amount        Decimal
  effectiveDate DateTime @map("effective_date")
  notes         String?
  createdById   String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  loan      Loan @relation(fields: [loanId], references: [id])
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([loanId, effectiveDate])
  @@map("loan_capital_movements")
}

// ─── Investors ──────────────────────────────────────────────────────────────

enum InvestorStatus {
  ACTIVE
  PAUSED
  WITHDRAWN
}

model Investor {
  id             String         @id @default(uuid())
  code           String         @unique
  name           String
  email          String?
  phone          String?
  phone2         String?        @map("phone_2")
  cedula         String?
  birthDate      DateTime?      @map("birth_date")
  nationality    String?
  type           String         @default("individual")
  photo          String?
  capital        Decimal        @default(0)
  monthlyPayment Decimal        @default(0) @map("monthly_payment")
  rate           Decimal        @default(0)
  startDate      DateTime?      @map("start_date")
  term           String?
  bank           String?
  status         InvestorStatus @default(ACTIVE)
  notes          String?
  createdById    String         @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  createdBy   User                 @relation(fields: [createdById], references: [id])
  documents   Document[]
  investments InvestorInvestment[]
  payments    InvestorPayment[]

  @@index([createdAt])
  @@map("investors")
}

model InvestorInvestment {
  id             String                   @id @default(uuid())
  investorId     String                   @map("investor_id")
  code           String                   @unique
  capital        Decimal                  @default(0)
  monthlyPayment Decimal                  @default(0) @map("monthly_payment")
  rate           Decimal                  @default(0)
  startDate      DateTime?                @map("start_date")
  term           String?
  status         InvestorInvestmentStatus @default(ACTIVE)
  notes          String?
  createdById    String                   @map("created_by")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  investor  Investor                     @relation(fields: [investorId], references: [id])
  createdBy User                         @relation("InvestorInvestmentCreatedBy", fields: [createdById], references: [id])
  payments  InvestorPayment[]
  movements InvestorInvestmentMovement[]

  @@index([investorId])
  @@index([createdAt])
  @@map("investor_investments")
}

model InvestorInvestmentMovement {
  id           String                         @id @default(uuid())
  investmentId String                         @map("investment_id")
  type         InvestorInvestmentMovementType
  amount       Decimal
  movementDate DateTime                       @map("movement_date")
  notes        String?
  createdById  String                         @map("created_by")
  createdAt    DateTime                       @default(now()) @map("created_at")

  investment InvestorInvestment @relation(fields: [investmentId], references: [id])
  createdBy  User               @relation("InvestorInvestmentMovementCreatedBy", fields: [createdById], references: [id])

  @@index([investmentId, movementDate(sort: Desc)])
  @@map("investor_investment_movements")
}

// ─── Investor Payments ─────────────────────────────────────────────────────

model InvestorPayment {
  id            String   @id @default(uuid())
  receiptNumber Int      @unique @map("receipt_number")
  investorId    String   @map("investor_id")
  investmentId  String?  @map("investment_id")
  amount        Decimal
  periodMonth   Int      @map("period_month")
  periodYear    Int      @map("period_year")
  paymentDate   DateTime @map("payment_date")
  paymentMethod String?  @map("payment_method")
  reference     String?
  notes         String?
  receivedById  String   @map("received_by")
  createdAt     DateTime @default(now()) @map("created_at")

  investor   Investor            @relation(fields: [investorId], references: [id])
  investment InvestorInvestment? @relation(fields: [investmentId], references: [id])
  receivedBy User                @relation("InvestorPaymentReceivedBy", fields: [receivedById], references: [id])

  @@index([investorId, periodYear(sort: Desc), periodMonth(sort: Desc)])
  @@index([investmentId, periodYear(sort: Desc), periodMonth(sort: Desc)])
  @@index([paymentDate])
  @@map("investor_payments")
}

// ─── Documents ──────────────────────────────────────────────────────────────

model Document {
  id                  String   @id @default(uuid())
  clientId            Int?     @map("client_id")
  investorId          String?  @map("investor_id")
  loanId              String?  @map("loan_id")
  name                String
  category            String   @default("general")
  fileUrl             String?  @map("file_url")
  fileSize            Int?     @map("file_size")
  mimeType            String?  @map("mime_type")
  originalFileUrl     String?  @map("original_file_url")
  processedFileUrl    String?  @map("processed_file_url")
  documentType        String   @default("otro") @map("document_type")
  detectionConfidence Int      @default(0) @map("detection_confidence")
  processingStatus    String   @default("not_applicable") @map("processing_status")
  processingNotes     String?  @map("processing_notes")
  notes               String?
  uploadedById        String   @map("uploaded_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  uploadedBy User      @relation(fields: [uploadedById], references: [id])
  client     Client?   @relation(fields: [clientId], references: [id])
  investor   Investor? @relation(fields: [investorId], references: [id])

  @@index([clientId, createdAt])
  @@index([investorId, createdAt])
  @@index([documentType])
  @@index([processingStatus])
  @@map("documents")
}

model DocumentCaptureSession {
  id          String    @id @default(uuid())
  token       String    @unique
  clientId    Int       @map("client_id")
  createdById String    @map("created_by")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  closedAt    DateTime? @map("closed_at")
  uploadCount Int       @default(0) @map("upload_count")
  maxUploads  Int       @default(5) @map("max_uploads")
  createdAt   DateTime  @default(now()) @map("created_at")

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([clientId, createdAt])
  @@index([token, expiresAt])
  @@map("document_capture_sessions")
}

model ClientPhotoCaptureSession {
  id          String    @id @default(uuid())
  token       String    @unique
  clientId    Int?      @map("client_id")
  createdById String    @map("created_by")
  expiresAt   DateTime  @map("expires_at")
  uploadedAt  DateTime? @map("uploaded_at")
  closedAt    DateTime? @map("closed_at")
  photoData   String?   @map("photo_data")
  createdAt   DateTime  @default(now()) @map("created_at")

  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([clientId, createdAt])
  @@index([token, expiresAt])
  @@map("client_photo_capture_sessions")
}

// ─── Tasks / Agenda ─────────────────────────────────────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Task {
  id                      String       @id @default(uuid())
  title                   String
  description             String?
  dueDate                 DateTime?    @map("due_date")
  time                    String?
  priority                TaskPriority @default(MEDIUM)
  category                String       @default("oficina")
  status                  TaskStatus   @default(PENDING)
  createdById             String       @map("created_by")
  assignedToId            String       @map("assigned_to")
  clientId                Int?         @map("client_id")
  loanId                  String?      @map("loan_id")
  collectionInteractionId String?      @unique @map("collection_interaction_id")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  createdBy             User                   @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignedTo            User                   @relation("TaskAssignee", fields: [assignedToId], references: [id])
  client                Client?                @relation(fields: [clientId], references: [id])
  loan                  Loan?                  @relation(fields: [loanId], references: [id])
  collectionInteraction CollectionInteraction? @relation(fields: [collectionInteractionId], references: [id])

  @@index([status(sort: Asc), priority(sort: Desc), dueDate(sort: Asc), createdAt(sort: Desc)])
  @@index([assignedToId, status, dueDate])
  @@index([clientId, status])
  @@index([loanId, status])
  @@map("tasks")
}

model NotificationRead {
  id     String   @id @default(uuid())
  userId String   @map("user_id")
  key    String
  readAt DateTime @default(now()) @map("read_at")
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, readAt])
  @@map("notification_reads")
}

// ─── Portfolios (Carteras) ──────────────────────────────────────────────────

model Portfolio {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#5FA37D")
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User   @relation(fields: [createdById], references: [id])
  loans     Loan[]

  @@index([createdAt])
  @@map("portfolios")
}

model SystemSettings {
  id             Int      @id @default(1)
  graceDays      Int      @default(5) @map("grace_days")
  companyName    String   @default("Inversiones Willians Marte") @map("company_name")
  companyTaxId   String?  @map("company_tax_id")
  companyEmail   String?  @map("company_email")
  companyPhone   String?  @map("company_phone")
  companyAddress String?  @map("company_address")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ─── Audit Log ──────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  createdAt  DateTime @default(now()) @map("created_at")
  clientId   Int?     @map("client_id")

  user   User    @relation(fields: [userId], references: [id])
  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
