{
  "name": "@inversiones/database",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev --schema ../../packages/database/prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema ../../packages/database/prisma/schema.prisma",
    "push": "prisma db push --schema ../../packages/database/prisma/schema.prisma",
    "studio": "prisma studio --schema ../../packages/database/prisma/schema.prisma",
    "seed": "tsx ../../packages/database/prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx ../../packages/database/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.5.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^5.1.1",
    "prisma": "6.5.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.0"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts"
}
